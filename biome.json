{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "packages/**/*.ts",
      "tooling/**/*.ts",
      "tests/**/*.ts",
      "benchmarks/**/*.ts",
      "!!**/node_modules",
      "!!packages/core/test/fixtures/core-0.1.2",
      "!!**/dist",
      "!!examples"
    ]
  },
  "overrides": [
    {
      "includes": ["tests/**"],
      "formatter": {
        "lineWidth": 160
      }
    }
  ]
}
