{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["bun", "node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["tooling/**/*.ts", "tooling/**/*.mts", "tests/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "tests/mcp/fixtures/two-package-consumer/**"]
}
